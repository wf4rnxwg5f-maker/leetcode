class Solution:
    def romanToInt(self, s: str) -> int:
        c = {'I': 1, 'V': 5, 'X':10, 'L':50, 'C': 100, 'D': 500, 'M':1000}
        wex= {'I': 1, 'V': 5, 'X':10, 'L':50, 'C': 100, 'D': 500, 'M':1000}
        flok = []
        total = 0
        for i in range(len(s)):
            y = c[s[i]]
            if i == len(s)-1:
                total += y
            else:
                re = c[s[i+1]]
                if y < re:
                    total = total - y
                else:
                    total = total + y
                    
        return total
