class Solution:
    def inorderTraversal(self, root: Optional[TreeNode]) -> List[int]:
        # 1. Создаем пустой список (корзину) для результата
        res = []
        
        # 2. Внутри функции создаем функцию-помощника.
        # Она должна просто заходить в узел и класть его в корзину.
        def dfs(node):
            # Если узла нет (мы дошли до тупика) - просто выходим
            if not node:
                return
            
            # 3. ПРАВИЛО INORDER: Лево -> Корень -> Право
            
            # Заходим в левую ветку (идем до самого конца)
            dfs(node.left)
            
            # Когда левая ветка закончилась, кладем текущее значение в корзину
            res.append(node.val)
            
            # Идем в правую ветку
            dfs(node.right)
        
        # 3. Запускаем нашего помощника с самого верха дерева (с корня)
        dfs(root)
        
        # 4. Возвращаем наполненную корзину
        return res
