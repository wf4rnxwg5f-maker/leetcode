class Solution:
    def isValid(self, s: str) -> bool:
        stack = []
        pairs = {')': '(', ']': '[', '}': '{'} 
        
        for char in s:
            if char not in pairs:
                stack.append(char)
            else:
                if len(stack)==0:
                    return False
                elif (stack.pop())!=pairs[char]:
                    return False
        if len(stack)==0:
            return True
        else:
            return False        
