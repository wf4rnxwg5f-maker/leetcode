class Solution:
    def searchInsert(self, nums: List[int], target: int) -> int:
        left = 0 
        right = len(nums)-1
        while left<=right:
            midl = (left+right)//2
            if nums[midl] == target:
                return midl 
            elif nums[midl] > target:
                right = midl - 1 
            else:
                left = midl +1
        return left 
