class Solution:
    def merge(self, nums1: list[int], m: int, nums2: list[int], n: int) -> None:
        c = []
        i = j = 0
        while i < m and j < n:
            if nums1[i] <= nums2[j]:
                c.append(nums1[i]); i += 1
            else:
                c.append(nums2[j]); j += 1
        while i < m:
            c.append(nums1[i]); i += 1
        while j < n:
            c.append(nums2[j]); j += 1
        nums1[:] = c
        return nums1
